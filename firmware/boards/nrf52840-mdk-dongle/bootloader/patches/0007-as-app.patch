--- a/lib/sdk11/components/libraries/bootloader_dfu/bootloader.c
+++ b/lib/sdk11/components/libraries/bootloader_dfu/bootloader.c
@@ -150,8 +150,12 @@
 
 static void bootloader_settings_save(bootloader_settings_t * p_settings)
 {
+  // The on-board test build runs under the factory bootloader, whose settings page
+  // this is: it writes nothing outside its scratch window.
+#ifndef VKEY_AS_APP
   nrfx_nvmc_page_erase(BOOTLOADER_SETTINGS_ADDRESS);
   nrfx_nvmc_words_write(BOOTLOADER_SETTINGS_ADDRESS, (uint32_t *) p_settings, sizeof(bootloader_settings_t) / 4);
+#endif
 
   pstorage_callback_handler(&m_bootsettings_handle, PSTORAGE_STORE_OP_CODE, NRF_SUCCESS, (uint8_t *) p_settings, sizeof(bootloader_settings_t));
 }
--- a/src/main.c
+++ b/src/main.c
@@ -110,10 +110,20 @@
 //--------------------------------------------------------------------+
 static void dfu_mode(bool asked_by_app);
 
+#ifdef VKEY_AS_APP
+void app_test_run(void);
+#endif
+
 //--------------------------------------------------------------------+
 //
 //--------------------------------------------------------------------+
 int main(void) {
+#ifdef VKEY_AS_APP
+  // The on-board test build (bootloader/test/app_test.c) runs from 0x1000 under the
+  // factory bootloader: its interrupts go to its own vectors, whatever the MBR forwards.
+  SCB->VTOR = MBR_SIZE;
+#endif
+
   // Populate Boot Address and MBR Param into MBR if not already
   // MBR_BOOTLOADER_ADDR/MBR_PARAM_PAGE_ADDR are used if available, else UICR registers are used
   // Note: skip it for now since this will prevent us to change the size of bootloader in the future
@@ -128,6 +138,14 @@
   PRINTF("Bootloader Start\r\n");
   led_state(STATE_BOOTLOADER_STARTED);
 
+#ifdef VKEY_AS_APP
+  // It is the application, so there is none to check or start: it checks its test
+  // images, then serves the drive until a reset.
+  app_test_run();
+  dfu_mode(false);
+  NVIC_SystemReset();
+#endif
+
   // The application asked for DFU mode: clear the request, so the next reset boots it
   bool const uf2_dfu = (NRF_POWER->GPREGRET == DFU_MAGIC_UF2_RESET);
   if (uf2_dfu) NRF_POWER->GPREGRET = 0;
