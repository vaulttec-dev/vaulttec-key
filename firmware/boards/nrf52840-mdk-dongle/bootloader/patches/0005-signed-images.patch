-      bootloader_dfu_start(0, false);
-    }
+  NVIC_SystemReset();
+}
+
+static void dfu_mode(bool asked_by_app) {
+  led_state(STATE_USB_UNMOUNTED);
+  usb_init();
 
-    usb_teardown();
+  if (asked_by_app) {
+    // If USB is not enumerated in 3s (eg. because we're running on battery), we restart into app.
+    bootloader_dfu_start(3000, true);
+  } else {
+    // No timeout when a person asked (the button) or there is nothing valid to boot.
+    bootloader_dfu_start(0, false);
   }
+
+  usb_teardown();
 }
 
